# ─────────────────────────────────────────────────────────────────────────────
# Wslny Backend — environment variables (copy to `.env` and fill in)
# ─────────────────────────────────────────────────────────────────────────────
# docker compose auto-loads this file at startup. Any variable referenced as
# `${VAR_NAME}` in docker-compose.yml will be substituted from the runtime
# `.env` file located next to `docker-compose.yml`.

# ─── Required ────────────────────────────────────────────────────────────────

# Google Maps Geocoding API key. Read by Ai-Service/geocoder.py at startup.
# Generate at: https://console.cloud.google.com/google/maps-apis/credentials
# Required: enable the "Geocoding API" for the project the key belongs to.
GOOGLE_MAPS_API_KEY=

# Admin seed credentials. Read by the seed_admin Django management command,
# invoked from API/Wslny/entrypoint.sh on every container start.
# Defaults (when DEBUG=True and these are unset):
#   ADMIN_SEED_EMAIL    → admin@wslny.com
#   ADMIN_SEED_PASSWORD → Admin@Wslny2026   (DEV FALLBACK; refused when DEBUG=False)
ADMIN_SEED_EMAIL=admin@wslny.com
ADMIN_SEED_PASSWORD=

# ─── Optional (already have sensible defaults in settings.py) ──────────────

# Django
# DJANGO_SECRET_KEY=change-me-in-production
# DEBUG=True                  # default
# ALLOWED_HOSTS=*             # default

# PostgreSQL (defaults match docker-compose service `db`)
# DB_NAME=wslny
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=db
# DB_PORT=5432

# Redis
# REDIS_URL=redis://redis:6379/0

# gRPC services (defaults match the docker-compose service names)
# AI_GRPC_HOST=ai-service
# AI_GRPC_PORT=50052
# ROUTING_GRPC_HOST=routing-engine
# ROUTING_GRPC_PORT=50051

# Fares (EGP)
# FARE_BUS_PER_RIDE=20
# FARE_MICROBUS_PER_RIDE=10
# FARE_METRO_UP_TO_9=8
# FARE_METRO_UP_TO_16=10
# FARE_METRO_UP_TO_23=15
# FARE_METRO_UP_TO_39=20

# Caching
# GTFS_CACHE_TIMEOUT=86400
# ROUTE_CACHE_TIMEOUT=300

# Logging
# LOG_LEVEL=INFO
# DJANGO_LOG_LEVEL=INFO
# APP_LOG_LEVEL=INFO

# Server
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=2
